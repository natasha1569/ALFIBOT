# Entorno de ejecución: development o production.
NODE_ENV=development

# Puerto en el que corre el servidor backend
PORT=4000

# Secreto usado para firmar tokens. Usa un valor propio y no lo subas a GitHub.
AUTH_TOKEN_SECRET=coloca_un_secreto_largo_y_aleatorio

# Endpoints /api/database/* para diagnóstico local.
# Mantener false salvo una prueba puntual y controlada.
ENABLE_DB_DIAGNOSTICS=false

# Tu API key de OpenAI. Nunca subas un .env real a GitHub.
OPENAI_API_KEY=coloca_tu_api_key_aqui

# Modelo principal. Se cambia aquí sin tocar código.
OPENAI_MODEL=gpt-5-mini

# Modelo de respaldo. Se usa si falla el principal.
OPENAI_FALLBACK_MODEL=gpt-4.1-mini

# Tiempo máximo de espera para OpenAI en milisegundos.
OPENAI_TIMEOUT_MS=35000
