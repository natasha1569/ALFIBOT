# Puerto en el que corre el servidor backend
PORT=4000

# Tu API key de OpenAI. Nunca subas un .env real a GitHub.
OPENAI_API_KEY=coloca_tu_api_key_aqui

# Modelo principal. Se cambia aquí sin tocar código.
OPENAI_MODEL=gpt-5-mini

# Modelo de respaldo. Se usa si falla el principal.
OPENAI_FALLBACK_MODEL=gpt-4.1-mini

# Tiempo máximo de espera para OpenAI en milisegundos.
OPENAI_TIMEOUT_MS=35000
